# Encrypted daily PostgreSQL backup for the HealthOS Compose deployment.
#
# Template: install.sh installs this unit with every /opt/healthos replaced by the
# checkout directory; without root it installs a user-unit variant (systemctl --user,
# lingering on) with the root-only lines removed and /etc/healthos replaced by
# ~/.config/healthos. Installing by hand from another directory: change those paths too.
#
# Install (adjust /opt/healthos to the directory holding docker-compose.yml):
#   sudo install -m 644 deploy/systemd/healthos-backup.service deploy/systemd/healthos-backup.timer \
#     deploy/systemd/healthos-backup-failure.service /etc/systemd/system/
#   sudo install -d -m 700 /etc/healthos
#   # Preferred: age public key only; keep the private identity off this host.
#   echo 'BACKUP_AGE_RECIPIENT=age1...' | sudo tee /etc/healthos/backup.env >/dev/null
#   # Fallback: gpg passphrase file (or an age identity) readable only by root.
#   #   sudo sh -c 'umask 077; openssl rand -base64 48 > /etc/healthos/backup.key'
#   sudo chmod 600 /etc/healthos/backup.env
#   sudo systemctl daemon-reload && sudo systemctl enable --now healthos-backup.timer
#   sudo systemctl start healthos-backup.service && journalctl -u healthos-backup.service -n 20
#
# Store the backup key (or the age identity) and GOOGLE_TOKEN_ENCRYPTION_KEY off
# this host, e.g. in a password manager: a restore needs both, and losing the
# backup key makes every backup unreadable.
#
# Backups are kept forever; nothing is deleted unless BACKUP_RETENTION_DAYS is
# set to a positive whole number (here, even empty, it overrides .env). A run refuses to start when the disk is short of
# space, and a failure starts healthos-backup-failure.service (logs at crit).
# Last result: <BACKUP_HOST_DIR>/last-backup-status.json.
[Unit]
Description=HealthOS encrypted PostgreSQL backup
Requires=docker.service
After=docker.service
OnFailure=healthos-backup-failure.service

[Service]
Type=oneshot
# Root is retained for the root-owned Docker socket and /etc/healthos/backup.key.
# Docker access is root-equivalent; an unprivileged account would need the same access.
User=root
WorkingDirectory=/opt/healthos
# Optional: BACKUP_AGE_RECIPIENT, BACKUP_KEY_FILE, BACKUP_HOST_DIR, BACKUP_STATUS_HOST_DIR,
# BACKUP_RETENTION_DAYS (default: never delete), BACKUP_MIN_FREE_MB,
# COMPOSE_FILE for override files.
EnvironmentFile=-/etc/healthos/backup.env
ExecStart=/bin/bash /opt/healthos/scripts/backup.sh
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# The capability set below is empty, so this root cannot read or write what the deploy user
# owns (.env is that user's, mode 600) and CAP_DAC_READ_SEARCH would open every file on the host
# to the whole script. Instead systemd itself reads the one file needed and hands the run a
# private copy in a non-swappable, unit-only directory; scripts/backup.sh passes it to Compose.
LoadCredential=healthos.env:/opt/healthos/.env
# A missing ReadWritePaths= entry would fail the unit at namespace setup (226/NAMESPACE) even
# for an ExecStartPre=+, so the entries are optional ("-") and the "+" step, the only part with
# full privileges, creates missing directories first. It also gives both directories to root:
# DEPLOYMENT step 4 and any earlier `make backup` leave them with the deploy user, whom this
# root cannot write for. Modes and contents stay as they are; the main command then gets them
# writable, and `make backup` reruns itself with sudo for them. For custom BACKUP_HOST_DIR/
# BACKUP_STATUS_HOST_DIR, adjust these absolute paths (and this ExecStartPre) in a unit override
# as well as backup.env.
ExecStartPre=+/bin/sh -ec 'test -d /opt/healthos/backups || install -d -m 700 /opt/healthos/backups; test -d /opt/healthos/backup-status || install -d -m 755 /opt/healthos/backup-status; chown -Rh root:root /opt/healthos/backups /opt/healthos/backup-status || echo "healthos-backup: could not take ownership of the backup directories" >&2'
ReadWritePaths=-/opt/healthos/backups -/opt/healthos/backup-status
# GPG needs writable private state; never write into the read-only root home.
RuntimeDirectory=healthos-backup-gnupg
RuntimeDirectoryMode=0700
Environment=GNUPGHOME=/run/healthos-backup-gnupg
Environment=PYTHONDONTWRITEBYTECODE=1
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
Nice=10
IOSchedulingClass=idle
