{
  "name": "healthos-ui",
  "private": true,
  "version": "0.2.2+1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "preview:shoot": "node preview/shoot.cjs",
    "test:unit": "node --test ../tests/frontend/*.test.mjs",
    "test:build": "node --test ../tests/frontend/budget-build.integration.mjs",
    "test:browser": "npm run typecheck && npm run test:unit && npm run test:build && node scripts/test-browser.mjs",
    "lint": "eslint . && npm run typecheck",
    "typecheck": "node scripts/generate-dom-ids.mjs && tsc -p tsconfig.json && node scripts/check-strict.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "dompurify": "3.4.17",
    "marked": "18.0.14",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
