# Shared application variables
# Which sources HealthOS reads, comma-separated: google, garmin, apple; or none.
# none (this template's default) starts with only POSTGRES_PASSWORD, POSTGRES_APP_PASSWORD and
# APP_UI_TOKEN: an empty archive, the dashboard and manual entries. Next step: set garmin once the
# key file is in place (README, "Connect Garmin"); production refuses to start otherwise.
# google needs an already approved Google Health API project and the Google and webhook values
# below; production refuses to start without them.
# apple is accepted but adds no data unless your checkout contains app/apple/ (docs/reference/sources.md).
# Removing this line means google, plus garmin if GARMIN_ENABLED=true: the behavior of an older .env.
HEALTHOS_SOURCES=none
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO
# Access key for the UI/API. Required in production; empty disables login only on loopback
# outside production. Production refuses a secret weaker than a generated one: 32+ characters,
# no common password, no repeated or sequential pattern (docs/reference/config.md, "Secret strength").
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
APP_UI_TOKEN=
# UI URL only; leave empty for local HTTP. Never use the Cloudflare webhook tunnel URL.
APP_PUBLIC_URL=
# Enable only behind a trusted proxy that replaces X-Forwarded-Proto (docs/UI_AUTH.md).
APP_TRUST_PROXY_HEADERS=false
# An upgrade aid, not a setting to keep: true lets a secret that passes only the earlier
# 16-character rule start, with a warning at every start, until you replace it.
HEALTHOS_ALLOW_LEGACY_SECRETS=false

# PostgreSQL variables (required; leave blank until a strong value is generated)
POSTGRES_PASSWORD=
# Non-superuser login the app uses at runtime; the schema stays owned by the migration role.
# Required with this template: `provision-app-role` stops if only one of the two is set. Generate
# the password (24-512 URL-safe characters) with
# `python3 -c "import secrets; print(secrets.token_hex(32))"`. Removing both lines keeps an
# install that already holds records connecting as the owner, which production refuses when it
# is a superuser (HEALTHOS_ALLOW_SUPERUSER_UNTIL, docs/reference/config.md);
# a new, empty database then stops at provision-app-role unless POSTGRES_ALLOW_OWNER_RUNTIME=1.
POSTGRES_APP_USER=healthos_app
POSTGRES_APP_PASSWORD=
# Used by native development. Compose constructs its own internal DATABASE_URL.
DATABASE_URL=

# Google OAuth variables (secrets have no example default)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://healthos.localhost:8000/auth/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Optional comma-separated previous root keys; reads append a version under the current key.
# Keep old keys separately for archived versions and backups after removing them here.
GOOGLE_TOKEN_ENCRYPTION_KEYS_OLD=
GOOGLE_CLOUD_PROJECT_NUMBER=

# Google Health webhook variables
GOOGLE_HEALTH_WEBHOOK_ENDPOINT_URI=
GOOGLE_HEALTH_WEBHOOK_SUBSCRIBER_ID=personal-health-mirror
# The exact header value Google's subscriber sends, e.g. "Bearer " plus a generated secret;
# 32+ characters after the prefix and the same strength rule as APP_UI_TOKEN.
GOOGLE_HEALTH_WEBHOOK_AUTHORIZATION=
# Maximum webhook body bytes, including verification payloads (1 KiB to 16 MiB).
GOOGLE_HEALTH_WEBHOOK_MAX_BODY_BYTES=2097152
GOOGLE_HEALTH_WEBHOOK_PUBLIC_KEY_URL=https://www.gstatic.com/googlehealthapi/webhooks/webhooks_public_keyset.json
WEBHOOK_HOST=

BACKFILL_START_DATE=2010-01-01
BACKFILL_WINDOW_DAYS=31
GOOGLE_API_PAGE_SIZE=10000
GOOGLE_API_MAX_RETRIES=6
GOOGLE_API_MIN_REQUEST_INTERVAL_SECONDS=0.25
SYNC_CONCURRENCY=2
EXTRA_DATA_TYPES=
ENABLED_DATA_TYPES=

RECONCILIATION_ENABLED=true
RECONCILIATION_DAILY_HOUR_UTC=2
RECONCILIATION_WEEKLY_DAY=sun
RECONCILIATION_WEEKLY_HOUR_UTC=3
RECONCILIATION_DAILY_DAYS=7
RECONCILIATION_WEEKLY_DAYS=90
# Nightly identity reconciler (decides renamed sources, links duplicate rows). It starts when
# the scheduled reconciliations have ended; the hour and minute apply only without them
# (RECONCILIATION_ENABLED=false). A busy data type is retried until the UNTIL time; after it,
# and by hand, for LOCK_WAIT_MINUTES (0: 8 attempts only).
IDENTITY_RECONCILE_ENABLED=true
IDENTITY_RECONCILE_HOUR_UTC=2
IDENTITY_RECONCILE_MINUTE=30
IDENTITY_RECONCILE_UNTIL_HOUR_UTC=3
IDENTITY_RECONCILE_UNTIL_MINUTE=55
IDENTITY_RECONCILE_LOCK_WAIT_MINUTES=60

# Read-only pull from the Garmin Connect Personal API, when HEALTHOS_SOURCES includes garmin.
# The Personal API key is read from GARMIN_API_KEY_FILE (mode 600), never from this file. The
# pull runs every GARMIN_PULL_INTERVAL_MINUTES (15-1440) outside 02:00-03:59 UTC and fetches the
# last GARMIN_LOOKBACK_DAYS (1-28). In Compose, docker-compose.garmin.yml mounts the key file
# and sets this path (README, "Connect Garmin"). GARMIN_ENABLED is the older switch and is read only when
# HEALTHOS_SOURCES is absent; with HEALTHOS_SOURCES present it has no effect, so it is not listed.
GARMIN_API_KEY_FILE=~/.config/garmin/connect-personal-api-key
GARMIN_PULL_INTERVAL_MINUTES=120
GARMIN_LOOKBACK_DAYS=3
# Name of the Garmin source in Cihazlarım (the Personal API exposes no device model).
GARMIN_DEVICE_NAME=Garmin

# Apple Health. The Health app's export.zip/export.xml can always be uploaded from the System
# page (or `healthos apple-import PATH`); nothing to configure. The receiver for the Health
# Auto Export iOS app (REST API automation) is off by default. To use it, create its token with
# `healthos apple-token` (written to APPLE_RECEIVER_TOKEN_FILE with mode 600, printed
# once) and add the printed `Authorization: Bearer ...` header to the automation. The phone
# needs an https address that reaches this app: set APPLE_RECEIVER_ENDPOINT_URI to it and only
# that host is admitted, only for POST /webhooks/apple-health. In Compose, mount the token file
# and point the path at the mount.
# APPLE_RECEIVER_ENABLED=false
# APPLE_RECEIVER_TOKEN_FILE=~/.config/healthos/apple-receiver-token
# APPLE_RECEIVER_ENDPOINT_URI=https://health.example.org/webhooks/apple-health
# APPLE_RECEIVER_MAX_BODY_BYTES=33554432
# APPLE_RECEIVER_REQUESTS_PER_MINUTE=30
# Largest export upload accepted from the System page (bytes; 8 GiB).
# APPLE_IMPORT_MAX_UPLOAD_BYTES=8589934592
# Most bytes an export.zip may decompress to (zip-bomb guard; 16 GiB). A zip that inflates more
# than 100 times its size is refused as well.
# APPLE_IMPORT_MAX_UNCOMPRESSED=17179869184

# Source precedence when two sources report the same data (same type, overlapping time):
# the first listed source is shown, the others stay visible as alternatives; nothing is
# summed. Sport activities (workouts and the heart rate, calories and distance inside a
# workout): Garmin first. Every other health metric (daily steps, sleep, resting heart rate,
# HRV, SpO2, continuous heart rate, stress, weight...): the Fitbit first. Reverse either by
# reordering its line; a source not listed ranks after the listed ones.
SOURCE_PRECEDENCE_ACTIVITY=GARMIN,FITBIT,HEALTH_KIT
SOURCE_PRECEDENCE_HEALTH=FITBIT,GARMIN,HEALTH_KIT

WATCHDOG_ENABLED=true
WATCHDOG_INTERVAL_SECONDS=900
PIPELINE_STALE_THRESHOLD_MINUTES=120
RECOVERY_COOLDOWN_MINUTES=360
STARTUP_GAP_THRESHOLD_MINUTES=120
AUTOMATIC_RECOVERY_ENABLED=true
AUTOMATIC_RECOVERY_MAX_DAYS=7
# Cihazlarım: a device whose newest record is at most this old is "bağlı"; older
# than DEVICES_DELAYED_DAYS it is "kopuk"; "gecikmeli" in between.
DEVICES_CONNECTED_HOURS=48
DEVICES_DELAYED_DAYS=7

# Read by scripts/backup.sh on the host. The backup encryption key never goes in
# this file: use BACKUP_AGE_RECIPIENT in /etc/healthos/backup.env or a mode-600
# /etc/healthos/backup.key (see deploy/systemd/healthos-backup.service).
# Backups are kept forever. Empty, 0, never or anything else: nothing is ever
# deleted. Only a positive whole number of days turns on automatic deletion of
# older health-* dumps. A value in the environment (even empty) overrides this.
# Free-space guard in MiB; empty: twice the newest dump (at least 1 GiB), or
# 5 GiB before the first dump. 0 disables the guard.
BACKUP_HOST_DIR=./backups
BACKUP_RETENTION_DAYS=
BACKUP_MIN_FREE_MB=

# Cloudflare credentials file and webhook hostname (deployment templates, not the app)
CLOUDFLARED_CREDENTIALS_FILE=
CLOUDFLARE_WEBHOOK_HOSTNAME=

# Compose wiring written by install.sh / install.ps1 (leave commented for a plain checkout).
# COMPOSE_FILE lists the Compose files `docker compose` uses; COMPOSE_PATH_SEPARATOR is ":" on
# Unix and ";" on Windows. The *_HOST_FILE keys are host paths of the Garmin key file and the
# Apple receiver token file that docker-compose.garmin.yml / docker-compose.apple.yml mount
# read-only; the *_HOST_GID keys are the group ids that may read them.
# COMPOSE_FILE=docker-compose.yml
# COMPOSE_PATH_SEPARATOR=:
# GARMIN_API_KEY_HOST_FILE=
# GARMIN_API_KEY_HOST_GID=
# APPLE_RECEIVER_TOKEN_HOST_FILE=
# APPLE_RECEIVER_TOKEN_HOST_GID=

## Local Codex site chat. start_codex_bridge.py writes these into your private .env.
# Bridge listen address; never 0.0.0.0. Empty: docker0 address on Linux, else 127.0.0.1.
# Only loopback and Docker bridge (docker0, br-*) addresses are accepted unless
# CODEX_BRIDGE_ALLOW_NON_LOCAL_BIND=1 is set (firewall port 8766 then; docs/reference/config.md).
CODEX_BRIDGE_BIND_HOST=
CODEX_BRIDGE_URL=wss://host.docker.internal:8766
# Generated by the launcher; a value you set must pass the same strength rule as APP_UI_TOKEN.
CODEX_BRIDGE_TOKEN=
