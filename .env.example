# Shared application variables
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO
# Access key for the UI/API (32+ characters). Required in production; empty disables
# the login outside production. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
APP_UI_TOKEN=

# PostgreSQL variables (required; leave blank until a strong value is generated)
POSTGRES_PASSWORD=
# Used by native development. Compose constructs its own internal DATABASE_URL.
DATABASE_URL=

# Google OAuth variables (secrets have no example default)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=

# Google Health webhook variables
GOOGLE_HEALTH_WEBHOOK_ENDPOINT_URI=
GOOGLE_HEALTH_WEBHOOK_SUBSCRIBER_ID=personal-health-mirror
GOOGLE_HEALTH_WEBHOOK_AUTHORIZATION=
# Maximum webhook body bytes, including verification payloads (1 KiB to 16 MiB).
GOOGLE_HEALTH_WEBHOOK_MAX_BODY_BYTES=2097152
GOOGLE_HEALTH_WEBHOOK_PUBLIC_KEY_URL=https://www.gstatic.com/googlehealthapi/webhooks/webhooks_public_keyset.json
WEBHOOK_HOST=

BACKFILL_START_DATE=2010-01-01
BACKFILL_WINDOW_DAYS=31
GOOGLE_API_PAGE_SIZE=10000
GOOGLE_API_MAX_RETRIES=6
GOOGLE_API_MIN_REQUEST_INTERVAL_SECONDS=0.25
SYNC_CONCURRENCY=2
EXTRA_DATA_TYPES=
ENABLED_DATA_TYPES=

RECONCILIATION_ENABLED=true
RECONCILIATION_DAILY_HOUR_UTC=2
RECONCILIATION_WEEKLY_DAY=sun
RECONCILIATION_WEEKLY_HOUR_UTC=3
RECONCILIATION_DAILY_DAYS=7
RECONCILIATION_WEEKLY_DAYS=90
# Nightly identity reconciler (decides renamed sources, links duplicate rows). It starts when
# the scheduled reconciliations have ended; the hour and minute apply only without them
# (RECONCILIATION_ENABLED=false). A busy data type is retried until the UNTIL time; after it,
# and by hand, for LOCK_WAIT_MINUTES (0: 8 attempts only).
IDENTITY_RECONCILE_ENABLED=true
IDENTITY_RECONCILE_HOUR_UTC=2
IDENTITY_RECONCILE_MINUTE=30
IDENTITY_RECONCILE_UNTIL_HOUR_UTC=3
IDENTITY_RECONCILE_UNTIL_MINUTE=55
IDENTITY_RECONCILE_LOCK_WAIT_MINUTES=60

# Optional read-only pull from the Garmin Connect Personal API (off by default). The Personal
# API key is read from GARMIN_API_KEY_FILE (mode 600), never from this file. The pull runs
# every GARMIN_PULL_INTERVAL_MINUTES (15-1440) outside 02:00-03:59 UTC and fetches the last
# GARMIN_LOOKBACK_DAYS (1-28). In Compose, mount the key file and point the path at the mount.
GARMIN_ENABLED=false
GARMIN_API_KEY_FILE=~/.config/garmin/connect-personal-api-key
GARMIN_PULL_INTERVAL_MINUTES=120
GARMIN_LOOKBACK_DAYS=3
# Name of the Garmin source in Cihazlarım (the Personal API exposes no device model).
GARMIN_DEVICE_NAME=Garmin

# Apple Health. The Health app's export.zip/export.xml can always be uploaded from the System
# page (or `health-mirror apple-import PATH`); nothing to configure. The receiver for the Health
# Auto Export iOS app (REST API automation) is off by default. To use it, create its token with
# `health-mirror apple-token` (written to APPLE_RECEIVER_TOKEN_FILE with mode 600, printed
# once) and add the printed `Authorization: Bearer ...` header to the automation. The phone
# needs an https address that reaches this app: set APPLE_RECEIVER_ENDPOINT_URI to it and only
# that host is admitted, only for POST /webhooks/apple-health. In Compose, mount the token file
# and point the path at the mount.
# APPLE_RECEIVER_ENABLED=false
# APPLE_RECEIVER_TOKEN_FILE=~/.config/healthos/apple-receiver-token
# APPLE_RECEIVER_ENDPOINT_URI=https://health.example.org/webhooks/apple-health
# APPLE_RECEIVER_MAX_BODY_BYTES=33554432
# APPLE_RECEIVER_REQUESTS_PER_MINUTE=30
# Largest export upload accepted from the System page (bytes; 8 GiB).
# APPLE_IMPORT_MAX_UPLOAD_BYTES=8589934592

# Source precedence when two sources report the same data (same type, overlapping time):
# the first listed source is shown, the others stay visible as alternatives; nothing is
# summed. Sport activities (workouts and the heart rate, calories and distance inside a
# workout): Garmin first. Every other health metric (daily steps, sleep, resting heart rate,
# HRV, SpO2, continuous heart rate, stress, weight...): the Fitbit first. Reverse either by
# reordering its line; a source not listed ranks after the listed ones.
SOURCE_PRECEDENCE_ACTIVITY=GARMIN,FITBIT,HEALTH_KIT
SOURCE_PRECEDENCE_HEALTH=FITBIT,GARMIN,HEALTH_KIT

WATCHDOG_ENABLED=true
WATCHDOG_INTERVAL_SECONDS=900
PIPELINE_STALE_THRESHOLD_MINUTES=120
RECOVERY_COOLDOWN_MINUTES=360
STARTUP_GAP_THRESHOLD_MINUTES=120
AUTOMATIC_RECOVERY_ENABLED=true
AUTOMATIC_RECOVERY_MAX_DAYS=7
# Cihazlarım: a device whose newest record is at most this old is "bağlı"; older
# than DEVICES_DELAYED_DAYS it is "kopuk"; "gecikmeli" in between.
DEVICES_CONNECTED_HOURS=48
DEVICES_DELAYED_DAYS=7

# Read by scripts/backup.sh on the host. The backup encryption key never goes in
# this file: use BACKUP_AGE_RECIPIENT in /etc/healthos/backup.env or a mode-600
# /etc/healthos/backup.key (see deploy/systemd/healthos-backup.service).
# Backups are kept forever. Empty, 0, never or anything else: nothing is ever
# deleted. Only a positive whole number of days turns on automatic deletion of
# older health-* dumps. A value in the environment (even empty) overrides this.
# Free-space guard in MiB; empty: twice the newest dump (at least 1 GiB), or
# 5 GiB before the first dump. 0 disables the guard.
BACKUP_HOST_DIR=./backups
BACKUP_RETENTION_DAYS=
BACKUP_MIN_FREE_MB=

# Cloudflare deployment variables (used by deployment templates, not the app)
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARED_CREDENTIALS_FILE=
CLOUDFLARE_WEBHOOK_HOSTNAME=

# Optional platform override variables; do not guess production paths
WINDOWS_BACKUP_HOST_DIR=
LINUX_BACKUP_HOST_DIR=
## Local Codex site chat. start_codex_bridge.py writes these into your private .env.
# Bridge listen address; never 0.0.0.0. Empty: docker0 address on Linux, else 127.0.0.1.
CODEX_BRIDGE_BIND_HOST=
CODEX_BRIDGE_URL=ws://host.docker.internal:8766
CODEX_BRIDGE_TOKEN=
